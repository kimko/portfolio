      #app-loader .loader-text {
        font-size: 14px;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: #9E9E9E;
        margin-bottom: 24px;
      }
      #app-loader .loader-bar {
        width: 60px;
        height: 2px;
        background: #E8E8E8;
        border-radius: 2px;
        overflow: hidden;
        position: relative;
      }
      #app-loader .loader-bar::after {
        content: '';
        position: absolute;
        top: 0;
        left: -60px;
        width: 60px;
        height: 100%;
        background: #D4A017;
        border-radius: 2px;
        animation: loader-slide 1.2s ease-in-out infinite;
      }
      @keyframes loader-slide {
        0% { left: -60px; }
        50% { left: 60px; }
        100% { left: -60px; }
